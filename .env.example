# ── Database (Neon) ─────────────────────────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/ecomfy?sslmode=require"
# Direct connection (same host without "-pooler") — used by prisma migrate / seed.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/ecomfy?sslmode=require"

# ── Better Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Public origin for canonical URLs / JSON-LD (defaults to BETTER_AUTH_URL).
# SITE_URL="https://ecomfy.example"

# Google OAuth (optional in dev — Google sign-in is disabled when empty).
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Uploaded avatars (Settings → Choose Image). Default: .data/uploads (gitignored).
# Production needs a persistent disk here, or swap lib/avatars.ts for a blob store.
# UPLOAD_DIR=""

# ── Seed ────────────────────────────────────────────────────────
# Seeded admin + staff accounts (admin@ecomfy.test, staff@ecomfy.test); 8+ chars.
SEED_PASSWORD="change-me-123"
# Every seeded customer account (dianne.russell@ecomfy.test, …); 8+ chars.
CUSTOMER_PASSWORD="change-me-456"

# ── Checkout & payments ─────────────────────────────────────────
# Public https origin the gateways call back to. Locally run a tunnel
# (`cloudflared tunnel --url http://localhost:3000`) and put its URL here. See README.
APP_URL="http://localhost:3000"
# Bearer token for /api/cron/expire-orders (openssl rand -hex 24).
CRON_SECRET=""

# bKash Tokenized Checkout (direct). Sandbox base:
# https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v2/tokenized-checkout"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# SSLCommerz v4 (cards / online banking). Sandbox store: https://developer.sslcommerz.com/registration/
SSLCZ_STORE_ID=""
SSLCZ_STORE_PASSWORD=""
SSLCZ_IS_LIVE="false"
