{
  "name": "ecomfy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && tsx scripts/check-design-rules.ts",
    "lint:design": "tsx scripts/check-design-rules.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens": "tsx scripts/tokens-to-css.ts",
